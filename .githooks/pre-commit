#!/bin/sh
# Refuse commits that add secrets (gitleaks, rules in .gitleaks.toml).
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:  git commit --no-verify   (CI still scans)
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed, secret scan skipped (https://github.com/gitleaks/gitleaks#installing)" >&2
    exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose .
